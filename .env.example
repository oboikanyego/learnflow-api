NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/learnflow
CLIENT_ORIGIN=http://localhost:4200
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
RESEND_API_KEY=
EMAIL_FROM=LearnFlow <onboarding@resend.dev>
REMINDER_CRON_SECRET=replace-with-a-random-secret-at-least-24-characters
