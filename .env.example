NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/learnflow
CLIENT_ORIGIN=http://localhost:4200
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
AI_QUEUE_CONCURRENCY=2
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
AI_PLAN_DAILY_LIMIT=5
AI_PLAN_MONTHLY_LIMIT=30
AI_COACH_DAILY_LIMIT=25
AI_COACH_MONTHLY_LIMIT=300
RESEND_API_KEY=
EMAIL_FROM=LearnFlow <onboarding@resend.dev>
REMINDER_CRON_SECRET=replace-with-a-random-secret-at-least-24-characters
